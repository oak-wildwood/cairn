
# Node / Vite
node_modules/
dist/
*.local
npm-debug.log*

# Stryker mutation testing (npm run test:mutation): reports and its sandbox.
reports/
.stryker-tmp/

# Playwright (npm run test:e2e): results, traces and the HTML report. A trace
# records everything the page showed, so none of it is ever committed.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor (per-machine)
.vscode/

# Vercel CLI (per-machine project link, not shared)
.vercel

# Agent tooling. AGENTS.md, CLAUDE.md and .claude/skills/ are shared and
# checked in. Per-machine settings are not.
.claude/settings.local.json
CLAUDE.local.md

# Design comps — reference only, deliberately not tracked.
# Their exact values live in src/lib/theme.ts. The icon files are the exception:
# tools/make-logo.py needs them as input. See tools/README.md.
design/*
!design/cairn-icon-source.jpeg
!design/cairn-icon-master.png
!design/cairn-icon-transparent.png
